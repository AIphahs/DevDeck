{
  "identifier": "default",
  "description": "Default capabilities for DevDeck",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "shell:allow-open",
    "notification:default",
    "os:default",
    "process:default",
    "global-shortcut:default",
    "store:default",
    "dialog:allow-open",
    "core:window:allow-minimize",
    "core:window:allow-close",
    "core:window:allow-toggle-maximize"
  ]
}
